# Configuration StudyVibe LMS
# Copiez ce fichier en .env et remplissez vos vraies valeurs.
# NE JAMAIS committer .env dans git.

# === Base de Données ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studyvibe
DB_USER=root
DB_PASS=

# === Application ===
# Clé secrète (chaine aléatoire de 64 caractères)
APP_SECRET=changez_cette_cle_secrete_avec_une_chaine_aleatoire_de_64_caracteres_minimum

# URL publique de l'application (sans slash final)
APP_URL=http://127.0.0.1:8123

# Passer à true en production avec un vrai certificat SSL
HTTPS_ONLY=false

# === Anti Brute-Force ===
# Nombre max de tentatives avant blocage
LOGIN_MAX_ATTEMPTS=5
# Durée du blocage en minutes
LOGIN_LOCKOUT_MINUTES=15

# === Email (PHPMailer-compatible via Mailer.php) ===
# Laisser SMTP_HOST vide pour utiliser mail() PHP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=StudyVibe

# Public contact address (footer, privacy page, support links)
CONTACT_EMAIL=studyvibelms@gmail.com

# === IA (Anthropic) ===
# One provider for everything: the marking of code and written answers, and the assistants. Set the key in the host's environment
# (Render: Environment), never in the repository or in chat; create a dedicated key with a monthly spend limit.
ANTHROPIC_API_KEY=
# Optional extra keys, comma separated: a load balancer spreads the calls over them (one lane per key and model).
ANTHROPIC_API_KEYS=
# Marking (strong model) and assistants (small model)
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_CHAT=claude-haiku-5-5
# Rate limiting: calls per minute and per key and model (stay under your plan's limit; 0 = no limit), and daily ceilings
ANTHROPIC_RPM=40
ANTHROPIC_DAILY_CALLS=2000
ANTHROPIC_DAILY_CHAT=3000

# === Mode développeur ===
# true : les erreurs techniques sont montrées dans les réponses JSON et le code SMS est renvoyé à l'écran
# (seulement avec SMS_DRIVER=log). TOUJOURS false en production.
APP_DEBUG=false
# true quand l'application est derrière un proxy (Railway, Render, Cloudflare) : lit l'adresse réelle du visiteur
TRUST_PROXY=false

# === SMS (codes de vérification et rappels d'évaluations en direct) ===
# Interrupteur général : false = aucun numéro demandé, aucun SMS, aucune vérification. Passer à true quand un fournisseur SMS fonctionne.
FEATURE_SMS=false
# log           : écrit les SMS dans uploads/sms_log/ (développement uniquement, exige APP_DEBUG=true)
# twilio        : renseigner TWILIO_SID, TWILIO_TOKEN et TWILIO_FROM (ou TWILIO_MESSAGING_SERVICE_SID)
# africastalking: renseigner AT_USERNAME et AT_API_KEY
SMS_DRIVER=log
SMS_SENDER_ID=StudyVibe
# Indicatif ajouté aux numéros saisis sans indicatif (237 = Cameroun)
SMS_DEFAULT_COUNTRY=237
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
AT_USERNAME=
AT_API_KEY=

# === Authentification à deux facteurs ===
# Rôles obligés d'activer l'application d'authentification, séparés par des virgules (ex : promoter,teacher). Vide = facultatif.
REQUIRE_2FA_ROLES=

# === Centre de contrôle (console super-administrateur) ===
# Adresses des promoteurs autorisés à voir et ouvrir le centre de contrôle, séparées par des virgules. Vide = tout promoteur.
# L'ouverture exige TOUJOURS la double preuve (code reçu par e-mail + application d'authentification) : voir DEPLOYMENT.md.
CONTROL_OWNER_EMAIL=

# Web push (notifications of the installed app). Generate once with: php scripts/generate-vapid.php
VAPID_PRIVATE_PEM_B64=
VAPID_SUBJECT=mailto:admin@studyvibe.edu
